flowchart TD
    classDef red fill:#FEE2E2,stroke:#E11927,stroke-width:1.5px,color:#991B1B;
    classDef navy fill:#E0E7FF,stroke:#0A2540,stroke-width:1.5px,color:#0A2540;
    classDef amber fill:#FEF3C7,stroke:#D97706,stroke-width:1.5px,color:#92400E;
    classDef green fill:#D1FAE5,stroke:#059669,stroke-width:1.5px,color:#065F46;

    A(["Operador elige&nbsp;<br/>referencia y destino&nbsp;"]):::navy --> V1{"¿Ambos activos&nbsp;<br/>y distintos?&nbsp;"}:::amber
    V1 -- No --> E1["ERR-02 / ERR-07&nbsp;<br/>no permite continuar&nbsp;"]:::red
    V1 -- Sí --> B["Muestra el perfil vigente&nbsp;<br/>y la diferencia de permisos&nbsp;"]:::navy
    B --> C["Confirma el perfil a copiar,&nbsp;<br/>ingresa ticket y motivo&nbsp;"]:::navy
    C --> V2{"¿Ticket y&nbsp;<br/>motivo?&nbsp;"}:::amber
    V2 -- No --> E2["ERR-03&nbsp;<br/>marca campos faltantes&nbsp;"]:::red
    E2 --> C
    V2 -- Sí --> D["API aplica la clonación&nbsp;<br/>en una transacción&nbsp;"]:::navy
    D --> V3{"¿El destino cambió&nbsp;<br/>mientras tanto?&nbsp;"}:::amber
    V3 -- Sí --> E3["ERR-05&nbsp;<br/>pide recargar la comparación&nbsp;"]:::red
    E3 --> B
    V3 -- No --> R(["Confirmación con&nbsp;<br/>enlace al evento de auditoría&nbsp;"]):::green
